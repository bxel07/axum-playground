# Salin ke .env lalu sesuaikan.

# Koneksi PostgreSQL (SeaORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/axum_playground

# Secret untuk menandatangani JWT (WAJIB diganti di produksi)
JWT_SECRET=ubah-ini-dengan-string-acak-yang-panjang
JWT_EXPIRES_HOURS=24

# Alamat server
SERVER_ADDR=0.0.0.0:3000

# Akun admin default (dibuat otomatis saat tabel users masih kosong)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Level log (opsional)
RUST_LOG=axum_playground=debug,tower_http=debug,info
